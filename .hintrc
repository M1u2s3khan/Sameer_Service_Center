{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "position: sticky",
          "-webkit-text-size-adjust",
          "scroll-behavior",
          "scroll-behavior: auto",
          "aspect-ratio",
          "scrollbar-width",
          "-webkit-overflow-scrolling",
          "scrollbar-width: none",
          "scroll-behavior: smooth",
          "inset",
          "inset: 0 0 auto 0",
          "inset: 0 0 auto 0",
          "min-height: auto",
          "min-height: auto",
          "min-height: auto"
        ]
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "img[loading]",
          "meta[name=theme-color]"
        ]
      }
    ],
    "no-inline-styles": "off",
    "axe/forms": [
      "default",
      {
        "select-name": "off"
      }
    ]
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 150",
    "not firefox <= 150"
  ]
}